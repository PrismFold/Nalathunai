        "inputs": {
          "language": "javascript",
          "mode": "all",
          "code": "const triggerData = $('webhook-otp-auth-trigger-01').item.json.body || {};\nconst aiSecurity = $('llm-otp-security-agent-03').item.json || {};\n\nconst rawIdent = triggerData.identifier || 'jeremiahgriffinpaul111@gmail.com';\nconst isEmail = rawIdent.includes('@');\nconst channel = triggerData.channel || (isEmail ? 'email' : 'sms');\nconst target = triggerData.target || rawIdent;\n\n// Generate random 6-digit OTP code\nconst dynamicOtp = Math.floor(100000 + Math.random() * 900000).toString();\nconst expiresAt = new Date(Date.now() + 5 * 60 * 1000).toISOString();\n\nreturn [{\n  success: true,\n  authorized: true,\n  eventType: 'OTP_DISPATCHED',\n  channel: channel,\n  target: target,\n  otp: dynamicOtp,\n  role: triggerData.role || 'patient',\n  userName: triggerData.userName || (isEmail ? rawIdent.split('@')[0] : 'Patient'),\n  expiresAt: expiresAt,\n  securityEvaluation: aiSecurity,\n  message: `Verification code ${dynamicOtp} successfully dispatched via ${channel === 'email' ? 'Gmail' : 'SMS'} to ${target}`\n}];"
