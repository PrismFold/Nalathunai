        "inputs": {
          "language": "javascript",
          "mode": "all",
          "code": "const triggerBody = $('webhook-patient-trigger-01').item.json.body || {};\nconst createdRow = $('supabase-create-row-03').item.json || {};\nconst fetchedRows = $('supabase-get-records-04').item.json || [];\nconst aiSummaryRaw = $('ai-summarization-agent-05').item.json || {};\n\nlet parsedSummary = aiSummaryRaw;\nif (typeof aiSummaryRaw === 'string') {\n  try {\n    parsedSummary = JSON.parse(aiSummaryRaw);\n  } catch (e) {\n    parsedSummary = { clinicalOverview: aiSummaryRaw };\n  }\n}\n\nconst recordsList = Array.isArray(fetchedRows) ? fetchedRows : (fetchedRows ? [fetchedRows] : []);\nconst totalRecords = recordsList.length + (createdRow ? 1 : 0);\n\nreturn [{\n  success: true,\n  mode: 'immediate_summary',\n  status: 'completed',\n  timestamp: new Date().toISOString(),\n  requestId: triggerBody.requestId || ('REQ-' + Date.now().toString().slice(-4)),\n  patient: {\n    id: triggerBody.patientId || createdRow.Patient_ID || 'PAT-9082',\n    name: triggerBody.patientName || createdRow.Patient_Name || 'Ananya Ramesh',\n    aadhaar: triggerBody.aadhaar || createdRow.Aadhaar || '8730-5083-3227'\n  },\n  hospital: triggerBody.hospitalName || createdRow.Hospital_Name || 'Ganga Hospital',\n  createdRecord: createdRow,\n  retrievedRecords: recordsList,\n  totalRecordsCount: totalRecords,\n  aiSummary: parsedSummary,\n  message: 'Patient record processed in Supabase and summarized successfully.'\n}];"
