        "isPrimaryTrigger": false,
        "inputs": {
          "language": "javascript",
          "mode": "all",
          "code": "const triggerBody = $('webhook-trigger').item.json.body || {};\nconst llmRaw = $('llm-agent').item.json || {};\nlet parsedLLM = llmRaw;\nif (typeof llmRaw === 'string') {\n  try {\n    parsedLLM = JSON.parse(llmRaw);\n  } catch (e) {\n    parsedLLM = { chatAnswer: llmRaw, suggestedFollowUps: ['How do I approve or revoke doctor consent?'] };\n  }\n}\nreturn [{ ...parsedLLM, success: true, mode: 'ai_chatbot', timestamp: new Date().toISOString() }];"
        },
